---
import { Image } from "astro:assets";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import type { ServicesContent } from "@app-types/content";

interface Props {
  content: ServicesContent;
}

const { content } = Astro.props;
---

<Section
  id="services"
  class="services-section"
  labelledby="services-title"
  spacing="default"
>
  <svg
    class="services-wave"
    viewBox="0 0 1440 160"
    preserveAspectRatio="none"
    aria-hidden="true"
    ><path d="M0 0H1440V65C1210 142 1052 132 856 94C612 47 424 178 0 86V0Z"
    ></path></svg
  >
  <Container size="content">
    <header class="services-intro">
      <p class="services-eyebrow type-eyebrow">{content.eyebrow}</p>
      <div class="services-heading-row">
        <h2 id="services-title" class="type-display-m">{content.title}</h2>
        <div class="services-intro-copy">
          <p class="services-script">Vestirte también puede sentirse fácil.</p>
          <p class="services-description type-body">{content.description}</p>
        </div>
      </div>
    </header>

    <div class="services-content">
      {
        content.image && (
          <figure class="services-image">
            <Image
              src={content.image.src}
              alt={content.image.alt}
              width="1122"
              height="1402"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
      <ol class="service-list" aria-label="Servicios de asesoría de imagen">
        {
          content.services.map((service, index) => (
            <li>
              <a class="service-link" href={service.href}>
                <span class="service-number">0{index + 1}</span>
                <span class="service-title type-heading-m">
                  {service.title}
                </span>
                <span class="service-link-description type-body-small">
                  {service.description}
                </span>
                <span class="service-link-entry type-caption">
                  {service.entryLabel} <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</Section>

<style>
  :global(.services-section) {
    background: var(--color-burnt-orange);
    color: var(--color-ink-black);
    margin: 0;
    overflow: hidden;
    padding-block: var(--space-6xl);
    position: relative;
  }

  .services-wave {
    fill: var(--color-cream-paper);
    height: 120px;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
  }

  :global(.services-section) :global(.container) {
    position: relative;
  }

  .services-intro {
    padding-top: var(--space-4xl);
  }

  .services-eyebrow {
    color: var(--color-deep-indigo);
    margin-bottom: var(--space-md);
  }

  .services-heading-row {
    align-items: end;
    display: grid;
    gap: var(--space-4xl);
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
  }

  .services-heading-row h2 {
    color: var(--color-deep-indigo);
    max-width: 10ch;
  }

  .services-intro-copy {
    display: grid;
    gap: var(--space-md);
    max-width: 34rem;
  }

  .services-script {
    color: var(--color-deep-indigo);
    font: 400 clamp(2rem, 3vw, 2.5rem) / 1 var(--font-script);
    transform: rotate(-3deg);
  }

  .services-content {
    display: grid;
    gap: var(--space-4xl);
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    margin-top: var(--space-5xl);
  }

  .services-image {
    margin: 0;
  }

  .services-image img {
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .service-list {
    border-top: 1px solid var(--color-ink-black);
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-list li {
    border-bottom: 1px solid var(--color-ink-black);
  }

  .service-link {
    align-items: start;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: auto minmax(0, 1fr) auto;
    padding: var(--space-xl) 0;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .service-link:hover,
  .service-link:focus-visible {
    color: var(--color-deep-indigo);
  }

  .service-number,
  .service-title,
  .service-link-entry {
    color: var(--color-deep-indigo);
  }

  .service-number {
    font: 400 46px / 0.86 var(--font-display);
    letter-spacing: 0.043em;
    margin: 0;
  }

  .service-link-description,
  .service-link .service-link-entry {
    grid-column: 2 / 4;
  }

  .service-link-description {
    max-width: 52ch;
  }

  @media (max-width: 48rem) {
    :global(.services-section) {
      padding-block: var(--space-5xl);
    }

    .services-heading-row,
    .services-content {
      gap: var(--space-xl);
      grid-template-columns: 1fr;
    }

    .services-image {
      max-width: 18rem;
    }

    .service-link {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .service-link-description,
    .service-link .service-link-entry {
      grid-column: 2;
    }

    .services-wave {
      height: 80px;
    }
  }
</style>
