---
import { Image } from "astro:assets";
import ButtonLink from "@components/ui/ButtonLink.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import type { ServiceDetail } from "@app-types/services";
import serviceDetailHero from "../../assets/images/service-detail-hero.png";

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;
const deliverablesId = `${service.slug}-deliverables`;
---

<main>
  <Section
    id={`${service.slug}-intro`}
    class="service-hero"
    labelledby={`${service.slug}-title`}
    spacing="default"
  >
    <div class="service-hero-media">
      <Image
        src={serviceDetailHero}
        alt="Paleta de color, telas, un lirio rosado y un espejo en una composición editorial."
        loading="eager"
        decoding="async"
      />
      <Container size="content">
        <div class="service-hero-content">
          <div class="service-hero-intro">
            <p class="type-eyebrow">{service.eyebrow}</p>
            <h1 id={`${service.slug}-title`} class="type-display-l">
              {service.title}
            </h1>
            <p class="service-lead type-heading-m">{service.lead}</p>
            <dl class="service-facts type-body-small">
              <div>
                <dt>Duración</dt>
                <dd>{service.duration}</dd>
              </div>
              <div>
                <dt>Valor</dt>
                <dd>{service.price}</dd>
              </div>
            </dl>
          </div>
        </div>
      </Container>
    </div>
  </Section>

  <Section
    id={`${service.slug}-details`}
    class="service-details"
    labelledby={deliverablesId}
    spacing="default"
  >
    <Container size="content">
      <div class="service-overview">
        <div class="service-details-intro">
          <p class="service-description type-body-l">{service.description}</p>
        </div>
        <svg
          class="service-botanical botanical-overview"
          viewBox="0 0 240 320"
          aria-hidden="true"
          ><g fill="none" stroke="currentColor" stroke-width="1.25"
            ><path d="M124 320C122 265 111 206 94 149C80 96 64 55 48 16"
            ></path><path
              d="M111 206C76 201 49 176 39 141C73 142 102 168 111 206Z"
            ></path><path
              d="M94 149C126 142 155 115 164 80C132 83 105 111 94 149Z"
            ></path><path d="M72 77C48 56 37 28 39 0C68 9 84 42 72 77Z"
            ></path></g
          ></svg
        >
        <div class="service-details-layout">
          <header class="service-details-heading">
            <p class="type-eyebrow">Un proceso pensado para ti</p>
            <h2 id={deliverablesId} class="type-display-l">
              {service.deliverablesLabel}
            </h2>
          </header>
          <ol class="deliverables-list">
            {
              service.deliverables.map((deliverable, index) => (
                <li>
                  <span class="deliverable-number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <p class="type-body">{deliverable}</p>
                </li>
              ))
            }
          </ol>
        </div>

        {
          service.requirement && (
            <aside
              class="service-recommendation"
              aria-labelledby={`${service.slug}-requirement`}
            >
              <p class="type-eyebrow">Requisito previo</p>
              <h2 id={`${service.slug}-requirement`} class="type-heading-m">
                {service.requirement.title}
              </h2>
              <p class="type-body">{service.requirement.description}</p>
            </aside>
          )
        }

        <div class="service-action" aria-label="Contacto">
          <p class="type-heading-m">¿Quieres comenzar?</p>
          <p class="type-body">
            Conversemos sobre el servicio que puede acompañarte mejor en este
            momento.
          </p>
          <ButtonLink
            {...service.action}
            analyticsPlacement="service_detail"
            variant="primary"
          />
          <svg
            class="service-botanical botanical-action"
            viewBox="0 0 260 260"
            fill="none"
            aria-hidden="true"
            ><path d="M38 246C72 184 114 117 214 24"></path><path
              d="M75 190C45 181 27 151 31 119C63 124 84 155 75 190Z"
            ></path><path
              d="M106 133C86 107 91 72 118 47C144 72 137 109 106 133Z"
            ></path><path d="M158 81C160 50 183 30 214 24C209 56 186 79 158 81Z"
            ></path></svg
          >
        </div>
      </div>
    </Container>

    <style>
      :global(.section.service-hero) {
        --service-hero-min-block: min(44rem, 78vh);
        background: var(--color-cream-paper);
        padding-block: 0;
      }

      .service-hero-media {
        min-height: var(--service-hero-min-block);
        overflow: hidden;
        position: relative;
      }

      .service-hero-media > :global(img) {
        height: 100%;
        inset: 0;
        object-fit: cover;
        position: absolute;
        width: 100%;
        z-index: 0;
      }

      .service-hero-content {
        align-items: center;
        display: flex;
        min-height: var(--service-hero-min-block);
        padding-block: calc(var(--space-6xl) + var(--target-size));
        position: relative;
        z-index: 1;
      }

      .service-details-layout {
        display: grid;
        gap: var(--space-4xl);
        grid-template-columns: minmax(0, 0.9fr) minmax(16rem, 1.1fr);
        margin-top: var(--space-4xl);
      }

      .service-hero-intro {
        display: grid;
        gap: var(--space-lg);
      }

      .service-details-heading {
        align-self: center;
        display: grid;
        gap: var(--space-heading);
      }

      .service-hero h1,
      .service-details h2,
      .service-lead {
        color: var(--color-deep-indigo);
      }

      .service-hero h1 {
        max-width: 11ch;
      }

      .service-lead {
        max-width: 20ch;
      }

      .service-facts {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-md) var(--space-3xl);
        margin: var(--space-sm) 0 0;
      }

      .service-facts div {
        display: grid;
        gap: var(--space-xs);
      }

      .service-facts dt {
        color: var(--color-deep-indigo);
        font-weight: 700;
      }

      .service-facts dd {
        margin: 0;
      }

      :global(.service-details) {
        background: var(--color-pure-white);
        overflow: hidden;
        position: relative;
      }

      .service-overview {
        border-bottom: 1px solid var(--color-ink-black);
        margin-bottom: var(--space-5xl);
        padding-bottom: var(--space-3xl);
        position: relative;
      }

      .service-details-intro {
        border-bottom: 1px solid var(--color-ink-black);
        padding-bottom: var(--space-4xl);
      }

      .service-description {
        margin-inline: auto;
        max-width: 52ch;
        text-align: center;
      }

      .service-details-heading h2 {
        max-width: 12ch;
      }

      .deliverables-list {
        border-top: 1px solid var(--color-ink-black);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .deliverables-list li {
        align-items: start;
        border-bottom: 1px solid var(--color-ink-black);
        display: grid;
        gap: var(--space-lg);
        grid-template-columns: auto minmax(0, 1fr);
        padding: var(--space-xl) 0;
      }

      .deliverable-number {
        color: var(--color-deep-indigo);
        font: var(--type-heading-m);
        letter-spacing: var(--type-heading-m-tracking);
      }

      .service-recommendation {
        background: var(--color-honey-gold);
        display: grid;
        gap: var(--space-md);
        margin: var(--space-5xl) 0 0 auto;
        max-width: 44rem;
        padding: var(--space-3xl);
      }

      .service-recommendation h2 {
        color: var(--color-deep-indigo);
      }

      .service-action {
        display: grid;
        gap: var(--space-md);
        margin-top: var(--space-5xl);
        max-width: 34rem;
        position: relative;
      }

      .service-action p:first-child {
        color: var(--color-deep-indigo);
      }

      .service-action :global(.button-link) {
        justify-self: start;
        margin-top: var(--space-md);
      }

      .service-botanical {
        color: var(--color-sky-blue);
        fill: none;
        height: auto;
        opacity: 0.72;
        pointer-events: none;
        position: absolute;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.5;
        user-select: none;
        width: auto;
      }

      .botanical-overview {
        right: calc(var(--space-xl) * -1);
        top: calc(var(--space-2xl) * -1);
        width: 8rem;
      }

      .botanical-action {
        bottom: calc(var(--space-lg) * -1);
        left: min(calc(60rem - var(--space-4xl)), calc(100vw - 29.375rem));
        width: 10rem;
        color: var(--color-mint-sage);
      }

      @media (max-width: 48rem) {
        :global(.section.service-hero) {
          --service-hero-min-block: 34rem;
        }

        .service-details-layout {
          gap: var(--space-xl);
          grid-template-columns: 1fr;
          margin-top: var(--space-3xl);
        }

        .service-hero-content {
          align-items: end;
          padding-block: calc(var(--space-5xl) + var(--target-size));
        }

        .service-hero-intro {
          max-width: 22rem;
        }

        .service-overview {
          margin-bottom: var(--space-4xl);
          padding-bottom: var(--space-2xl);
        }

        .service-recommendation {
          margin-top: var(--space-4xl);
          padding: var(--space-xl);
        }

        .service-action {
          margin-top: var(--space-4xl);
        }

        .botanical-overview {
          display: none;
        }

        .botanical-action {
          display: none;
        }
      }
    </style>
  </Section>
</main>
