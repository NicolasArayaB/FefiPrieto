---
import ButtonLink from "@components/ui/ButtonLink.astro";
import Container from "@components/ui/Container.astro";
import Grid from "@components/ui/Grid.astro";
import Section from "@components/ui/Section.astro";
import type { HeroContent } from "@app-types/content";

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<Section class="hero-section" labelledby="hero-title" spacing="hero">
  <Container size="full">
    <Grid class="hero-layout" variant="editorial" align="center">
      <div class="hero-copy">
        <p class="eyebrow type-eyebrow">{content.eyebrow}</p>
        <h1 id="hero-title" class="type-display-xl">{content.title}</h1>
        <p class="hero-description type-lead">{content.description}</p>
        <div class="hero-actions">
          <ButtonLink {...content.primaryCta} variant="primary" />
        </div>
      </div>
      <div class="hero-companion">
        <figure class="hero-image">
          <img
            src="/images/hero-editorial-placeholder.webp"
            alt={content.image.alt}
            width="1024"
            height="1536"
            decoding="async"
          />
        </figure>
      </div>
    </Grid>
  </Container>
</Section>

<style>
  .hero-section {
    align-items: center;
    display: flex;
    min-block-size: 100vh;
    min-block-size: 100dvh;
  }

  .hero-layout {
    padding-block: var(--space-content);
  }

  .hero-copy {
    margin-left: var(--space-content);
  }

  .eyebrow {
    color: var(--color-brand);
    margin: 0 0 var(--space-heading);
  }

  h1 {
    max-width: 10ch;
  }

  .hero-description {
    color: var(--color-text-secondary);
    margin-top: var(--space-heading-to-body);
    max-width: var(--layout-reading);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-element-tight);
    margin-top: var(--space-body-to-action);
  }

  .hero-companion {
    background: var(--color-expression-orange);
    padding: var(--space-content-tight) 0 0 var(--space-content-tight);
  }

  .hero-image {
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
  }

  .hero-image img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 48rem) {
    .hero-section {
      min-block-size: auto;
    }

    .hero-companion {
      max-width: var(--layout-copy);
      padding: var(--space-content-tight) 0 0 var(--space-content-tight);
    }
  }

  @media (max-width: 640px) {
    .hero-layout {
      padding-block: var(--space-content-tight);
    }

    h1.type-display-xl {
      max-width: 8ch;
    }
  }
</style>
