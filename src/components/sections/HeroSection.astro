---
import ButtonLink from "@components/ui/ButtonLink.astro";
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import type { HeroContent } from "@app-types/content";

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<Section class="hero-section" labelledby="hero-title" spacing="hero">
  <Container size="wide">
    <div class="hero-frame surface-panel">
      <div class="hero-copy">
        <p class="eyebrow type-eyebrow">{content.eyebrow}</p>
        <h1 id="hero-title" class="type-display-xl">{content.title}</h1>
        <p class="hero-description type-lead">{content.description}</p>
        <div class="hero-actions" aria-label="Primary actions">
          <ButtonLink {...content.primaryCta} variant="primary" />
          <ButtonLink {...content.secondaryCta} />
        </div>
      </div>
      <aside class="hero-aside" aria-label="Brand statement">
        <p class="hero-aside-label type-label">Foundational belief</p>
        <p class="hero-aside-text type-quote">
          Image is not superficial. It is psychological.
        </p>
      </aside>
    </div>
  </Container>
</Section>

<style>
  .hero-section {
    align-items: center;
    display: flex;
    min-height: 92vh;
  }

  .hero-frame {
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-content);
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 0.8fr);
    padding: var(--space-content);
    position: relative;
    overflow: hidden;
  }

  .hero-frame::after {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-brand) 12%, transparent),
        transparent 46%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-surface-elevated) 94%, transparent),
        color-mix(in srgb, var(--color-surface-elevated) 58%, transparent)
      );
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero-copy,
  .hero-aside {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    color: var(--color-brand);
    margin: 0 0 var(--space-heading);
  }

  h1 {
    max-width: 10ch;
  }

  .hero-description {
    color: var(--color-text-secondary);
    margin-top: var(--space-heading-to-body);
    max-width: var(--width-reading);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-element-tight);
    margin-top: var(--space-body-to-action);
  }

  .hero-aside {
    align-self: end;
    background: color-mix(
      in srgb,
      var(--color-surface-elevated) 72%,
      transparent
    );
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-content-tight);
  }

  .hero-aside-label {
    color: var(--color-text-muted);
    margin-bottom: var(--space-element-tight);
  }

  @media (max-width: 900px) {
    .hero-frame {
      grid-template-columns: 1fr;
    }

    .hero-aside {
      max-width: var(--width-copy);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      align-items: flex-start;
      min-height: 100vh;
    }

    .hero-frame {
      border-radius: var(--radius-md);
      gap: var(--space-content-tight);
      padding: var(--space-content-tight);
    }

    h1.type-display-xl {
      max-width: 8ch;
    }
  }
</style>
