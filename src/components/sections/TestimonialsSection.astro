---
import Container from "@components/ui/Container.astro";
import Section from "@components/ui/Section.astro";
import type { Testimonial, TestimonialsContent } from "@app-types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;
const testimonials: Testimonial[] = [content.featured, ...content.supporting];
const testimonialCards = testimonials.map((testimonial, index) => ({
  testimonial,
  tone: (["sage", "gold", "sage"] as const)[index] ?? "sage",
}));
---

<Section
  class="testimonials-section"
  labelledby="testimonials-title"
  spacing="default"
>
  <Container size="content">
    <header class="testimonials-intro">
      <div>
        <p class="testimonials-eyebrow type-eyebrow">{content.eyebrow}</p>
        <h2 id="testimonials-title" class="type-display-m">{content.title}</h2>
      </div>
      <div class="testimonials-intro-copy">
        <p class="testimonials-script">Lo que cambia cuando te reconoces.</p>
        <p class="testimonials-description type-body">{content.description}</p>
      </div>
    </header>
  </Container>

  <div
    class="testimonial-swiper"
    data-testimonial-swiper
    data-slide-count={testimonialCards.length}
    aria-label={content.supportingLabel}
  >
    <div class="testimonial-track" data-testimonial-track>
      {
        testimonialCards.map((item, index) => (
          <article
            class:list={["testimonial-card", `testimonial-card-${item.tone}`]}
            aria-hidden={index !== 0 && index !== 1}
            data-testimonial-slide
          >
            <blockquote class="testimonial-quote type-heading-l">
              <p>{item.testimonial.quote}</p>
            </blockquote>
            <footer class="testimonial-attribution">
              {item.testimonial.name && (
                <p class="testimonial-name type-body">
                  {item.testimonial.name}
                </p>
              )}
              {item.testimonial.context && (
                <p class="testimonial-context type-caption">
                  {item.testimonial.context}
                </p>
              )}
              {item.testimonial.relationship && (
                <p class="testimonial-relationship type-caption">
                  {item.testimonial.relationship}
                </p>
              )}
            </footer>
          </article>
        ))
      }
      <svg
        class="testimonial-divider testimonial-divider-sage"
        viewBox="0 0 480 560"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0 0h240c-20 112-35 194 45 320 45 86-10 182-45 280H0z"></path>
      </svg>
      <svg
        class="testimonial-divider testimonial-divider-gold"
        viewBox="0 0 480 560"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0 0H240C220 112 205 194 265 280C330 366 275 462 240 560H0V0Z"
        ></path>
      </svg>
    </div>
  </div>
</Section>

<script>
  import { initTestimonialSwiper } from "@animations/testimonials";
  initTestimonialSwiper();
</script>

<style>
  :global(.testimonials-section) {
    background: var(--color-cream-paper);
    margin: 0;
    overflow: hidden;
    padding-block: var(--space-6xl);
  }
  .testimonials-intro {
    align-items: end;
    display: grid;
    gap: var(--space-4xl);
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
  }
  .testimonials-eyebrow {
    color: var(--color-deep-indigo);
    margin-bottom: var(--space-md);
  }
  .testimonials-intro h2 {
    color: var(--color-deep-indigo);
    max-width: 11ch;
  }
  .testimonials-intro-copy {
    display: grid;
    gap: var(--space-md);
    max-width: 34rem;
  }
  .testimonials-script {
    color: var(--color-deep-indigo);
    font: 400 clamp(2rem, 3vw, 2.5rem) / 1 var(--font-script);
    transform: rotate(-3deg);
  }
  .testimonial-swiper {
    margin-top: var(--space-5xl);
    overflow: hidden;
  }
  .testimonial-track {
    display: flex;
    position: relative;
    transform: translateX(0);
    width: 150%;
    will-change: transform;
  }
  .testimonial-card {
    color: var(--color-deep-indigo);
    display: grid;
    flex: 0 0 calc(100% / 3);
    gap: var(--space-xl);
    grid-template-rows: 1fr auto;
    min-height: 560px;
    overflow: hidden;
    padding: var(--space-4xl)
      max(var(--space-page), calc((100vw - var(--layout-content)) / 2));
    position: relative;
    z-index: 1;
  }
  .testimonial-card-sage {
    background: var(--color-mint-sage);
    padding-right: calc(var(--space-page) + var(--space-5xl));
    padding-left: var(--space-6xl);
  }
  .testimonial-card-gold {
    background: var(--color-honey-gold);
    padding-left: calc(var(--space-page) + var(--space-5xl));
  }
  .testimonial-quote {
    margin: 0;
    max-width: 15ch;
    position: relative;
    z-index: 5;
  }
  .testimonial-attribution {
    border-top: 1px solid var(--color-deep-indigo);
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    position: relative;
    z-index: 5;
  }
  .testimonial-name,
  .testimonial-context,
  .testimonial-relationship {
    margin: 0;
  }
  .testimonial-divider {
    height: 100%;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 180px;
    z-index: 2;
  }
  .testimonial-divider-sage {
    fill: var(--color-mint-sage);
    left: calc(43.333% - 240px);
  }
  .testimonial-divider-gold {
    fill: var(--color-honey-gold);
    left: calc(76.666% - 240px);
  }
  @media (max-width: 48rem) {
    :global(.testimonials-section) {
      padding-block: var(--space-5xl);
    }
    .testimonials-intro {
      gap: var(--space-xl);
      grid-template-columns: 1fr;
    }
    .testimonial-swiper {
      margin-top: var(--space-4xl);
    }
    .testimonial-card {
      gap: var(--space-md);
      min-height: 500px;
      padding: var(--space-xl) var(--space-md);
    }
    .testimonial-card-sage {
      padding-right: var(--space-lg);
    }
    .testimonial-card-gold {
      padding-left: var(--space-lg);
    }
    .testimonial-quote {
      font-size: clamp(1.5rem, 7vw, 2rem);
      line-height: 0.95;
    }
    .testimonial-name {
      font-size: 0.875rem;
    }
    .testimonial-context,
    .testimonial-relationship {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
    .testimonial-divider {
      width: 150px;
    }
    .testimonial-divider-sage {
      left: calc(33.333% - 75px);
    }
    .testimonial-divider-gold {
      left: calc(66.666% - 75px);
    }
  }
</style>
