---
import Container from "@components/ui/Container.astro";
import Grid from "@components/ui/Grid.astro";
import Section from "@components/ui/Section.astro";
import type { TestimonialsContent } from "@app-types/content";

interface Props {
  content: TestimonialsContent;
}

const { content } = Astro.props;
---

<Section
  class="testimonials-section"
  labelledby="testimonials-title"
  spacing="default"
>
  <Container size="content">
    <header class="testimonials-intro">
      <p class="testimonials-eyebrow type-eyebrow">{content.eyebrow}</p>
      <h2 id="testimonials-title" class="type-heading-xl">{content.title}</h2>
      <p class="testimonials-description type-body">
        {content.description}
      </p>
    </header>

    <article class="featured-testimonial">
      <Grid variant="editorial" align="end">
        <blockquote class="featured-quote type-heading-l">
          <p>{content.featured.quote}</p>
        </blockquote>
        <footer class="featured-attribution">
          {
            content.featured.name && (
              <p class="type-body">{content.featured.name}</p>
            )
          }
          {
            content.featured.context && (
              <p class="featured-context type-caption">
                {content.featured.context}
              </p>
            )
          }
          {
            content.featured.relationship && (
              <p class="featured-relationship type-caption">
                {content.featured.relationship}
              </p>
            )
          }
        </footer>
      </Grid>
    </article>

    <section class="supporting-section" aria-label={content.supportingLabel}>
      <Grid class="supporting-testimonials" variant="two">
        {
          content.supporting.map((testimonial, index) => (
            <article
              class:list={[
                "supporting-testimonial",
                `supporting-testimonial-${index}`,
              ]}
            >
              <blockquote class="supporting-quote type-heading-m">
                <p>{testimonial.quote}</p>
              </blockquote>
              <footer class="supporting-attribution">
                {testimonial.name && (
                  <p class="type-body-small">{testimonial.name}</p>
                )}
                {testimonial.context && (
                  <p class="supporting-context type-caption">
                    {testimonial.context}
                  </p>
                )}
                {testimonial.relationship && (
                  <p class="supporting-relationship type-caption">
                    {testimonial.relationship}
                  </p>
                )}
              </footer>
            </article>
          ))
        }
      </Grid>
    </section>
  </Container>
</Section>

<style>
  .testimonials-section {
    border-block-start: 1px solid var(--color-border-subtle);
    margin-block-start: var(--space-section);
  }

  .testimonials-eyebrow {
    color: var(--color-brand);
    margin-bottom: var(--space-heading);
  }

  .testimonials-intro h2 {
    max-width: var(--layout-copy);
  }

  .testimonials-description {
    color: var(--color-text-secondary);
    margin-top: var(--space-content-tight);
    max-width: var(--layout-copy);
  }

  .featured-testimonial {
    background: var(--color-expression-orange);
    color: var(--color-on-expression-orange);
    margin-top: var(--space-content);
    padding: var(--space-content);
  }

  .featured-quote,
  .supporting-quote {
    margin: 0;
  }

  .featured-quote {
    max-width: var(--layout-reading);
  }

  .featured-attribution,
  .supporting-attribution {
    display: grid;
    gap: var(--space-element-tight);
  }

  .featured-context,
  .featured-relationship {
    color: var(--color-on-expression-orange);
  }

  .supporting-section {
    margin-top: var(--space-content);
  }

  .supporting-testimonials {
    gap: var(--space-content);
  }

  .supporting-testimonial {
    border-block-start: 1px solid var(--color-border-subtle);
    padding-top: var(--space-content-tight);
  }

  .supporting-attribution {
    margin-top: var(--space-element);
  }

  .supporting-context,
  .supporting-relationship {
    color: var(--color-text-secondary);
  }

  @media (max-width: 48rem) {
    .featured-testimonial {
      padding: var(--space-content-tight);
    }

    .supporting-section {
      margin-top: var(--space-content-tight);
    }

    .supporting-testimonials {
      gap: var(--space-section-compact);
    }
  }
</style>
