---
import Container from "@components/ui/Container.astro";
import Grid from "@components/ui/Grid.astro";
import Section from "@components/ui/Section.astro";
import type { MethodologyContent } from "@app-types/content";

interface Props {
  content: MethodologyContent;
}

const { content } = Astro.props;
---

<Section
  class="methodology-section"
  labelledby="methodology-title"
  spacing="editorial"
>
  <Container size="content">
    <header class="methodology-intro">
      <p class="methodology-eyebrow type-eyebrow">{content.eyebrow}</p>
      <Grid variant="editorial" align="end">
        <h2 id="methodology-title" class="type-display-m">
          {content.title}
        </h2>
        <p class="methodology-description type-body-l">{content.description}</p>
      </Grid>
    </header>

    <ol class="methodology-stages" aria-label={content.stagesLabel}>
      {
        content.stages.map((stage, index) => (
          <li>
            <Grid class="methodology-stage" variant="editorial" align="start">
              <div class="methodology-stage-heading">
                <p class="methodology-stage-index type-eyebrow">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="type-heading-l">{stage.title}</h3>
              </div>
              <p class="methodology-stage-description type-body">
                {stage.description}
              </p>
            </Grid>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<style>
  .methodology-section {
    border-block-start: 1px solid var(--color-border-subtle);
    margin-block-start: var(--space-section);
  }

  .methodology-eyebrow {
    color: var(--color-brand);
    margin-bottom: var(--space-heading);
  }

  .methodology-description {
    color: var(--color-text-secondary);
    max-width: var(--layout-reading);
  }

  .methodology-stages {
    list-style: none;
    margin: var(--space-section) 0 0;
    padding: 0;
  }

  .methodology-stages > li {
    border-block-start: 1px solid var(--color-border-subtle);
    padding-block: var(--space-content);
  }

  .methodology-stages > li:last-child {
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .methodology-stage-heading {
    display: grid;
    gap: var(--space-element-tight);
  }

  .methodology-stage-index {
    color: var(--color-text-muted);
  }

  .methodology-stage-description {
    color: var(--color-text-secondary);
    max-width: var(--layout-reading);
  }
</style>
