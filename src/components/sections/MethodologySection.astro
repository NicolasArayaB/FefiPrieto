---
import Container from "@components/ui/Container.astro";
import Grid from "@components/ui/Grid.astro";
import Section from "@components/ui/Section.astro";
import type { MethodologyContent } from "@app-types/content";

interface Props {
  content: MethodologyContent;
}

const { content } = Astro.props;
---

<Section
  class="methodology-section"
  labelledby="methodology-title"
  spacing="default"
>
  <Container size="content">
    <header class="methodology-intro">
      <p class="methodology-eyebrow type-eyebrow">{content.eyebrow}</p>
      <Grid variant="editorial" align="end">
        <h2 id="methodology-title" class="type-heading-xl">
          {content.title}
        </h2>
        <p class="methodology-description type-body">{content.description}</p>
      </Grid>
    </header>

    <ol class="methodology-stages" aria-label={content.stagesLabel}>
      {
        content.stages.map((stage, index) => (
          <li>
            <p class="methodology-stage-index type-eyebrow">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="type-heading-m">{stage.title}</h3>
            <p class="methodology-stage-description type-body-small">
              {stage.description}
            </p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<style>
  .methodology-section {
    border-block-start: 1px solid var(--color-border-subtle);
    margin-block-start: var(--space-section);
  }

  .methodology-eyebrow {
    color: var(--color-brand);
    margin-bottom: var(--space-heading);
  }

  .methodology-description {
    color: var(--color-text-secondary);
    max-width: var(--layout-reading);
  }

  .methodology-stages {
    display: grid;
    gap: var(--space-content);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: var(--space-content) 0 0;
    padding: 0;
  }

  .methodology-stages > li {
    border-block-start: 1px solid var(--color-border-subtle);
    display: grid;
    gap: var(--space-element);
    padding-top: var(--space-content-tight);
  }

  .methodology-stage-index {
    color: var(--color-text-muted);
  }

  .methodology-stage-description {
    color: var(--color-text-secondary);
  }

  @media (max-width: 48rem) {
    .methodology-stages {
      gap: var(--space-content-tight);
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
