---
interface Props {
  align?: "start" | "center" | "end" | "stretch";
  class?: string;
  variant?: "single" | "two" | "three" | "editorial";
}

const { align = "stretch", class: className, variant = "two" } = Astro.props;
---

<div class:list={["grid", `grid-${variant}`, `grid-align-${align}`, className]}>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    gap: var(--space-content);
  }

  .grid-single {
    grid-template-columns: minmax(0, 1fr);
  }

  .grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .grid-editorial {
    grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 0.8fr);
  }

  .grid-align-start {
    align-items: start;
  }

  .grid-align-center {
    align-items: center;
  }

  .grid-align-end {
    align-items: end;
  }

  .grid-align-stretch {
    align-items: stretch;
  }

  @media (max-width: 48rem) {
    .grid-two,
    .grid-three,
    .grid-editorial {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
