---
interface Props {
  id: string;
  class?: string;
  labelledby?: string;
  spacing?: "default" | "compact" | "editorial" | "hero";
}

const {
  id: id,
  class: className,
  labelledby,
  spacing = "default",
} = Astro.props;
---

<section
  id={id}
  class:list={["section", `section-${spacing}`, className]}
  aria-labelledby={labelledby}
>
  <slot />
</section>

<style>
  .section {
    padding-block: var(--space-section);
  }

  .section-compact {
    padding-block: var(--space-section-compact);
  }

  .section-editorial {
    padding-block: var(--space-section-editorial);
  }

  .section-hero {
    padding-block: var(--space-section-hero);
  }
</style>
