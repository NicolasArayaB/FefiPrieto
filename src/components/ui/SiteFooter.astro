---
import { ui } from "@content/ui";
import { getLocale, pagePath } from "@lib/i18n";
const locale = getLocale(Astro.currentLocale);
const text = ui[locale];
import { instagramUrl } from "@content/contact";
---

<footer class="site-footer">
  <div class="site-footer-content">
    <a
      class="site-footer-wordmark"
      href={pagePath("home", locale)}
      aria-label={text.home}>FERNANDA PRIETO</a
    >
    <nav class="site-footer-links" aria-label={text.footer}>
      <a href={instagramUrl} target="_blank" rel="noreferrer"
        >Instagram <span aria-hidden="true">↗</span></a
      >
      <a href={pagePath("privacy", locale)}>{text.privacy}</a>
      <a href={pagePath("terms", locale)}>{text.terms}</a>
      <button type="button" data-manage-analytics-consent>{text.cookies}</button
      >
    </nav>
    <p class="site-footer-copyright type-caption">
      © {new Date().getFullYear()} Fernanda Prieto
    </p>
  </div>
</footer>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-manage-analytics-consent]")
    ?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("open-analytics-consent"));
    });
</script>

<style>
  .site-footer {
    background: var(--color-deep-indigo);
    color: var(--color-pure-white);
    padding: var(--space-2xl) var(--space-page) var(--space-lg);
  }
  .site-footer-content {
    align-items: center;
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr) auto auto;
    margin-inline: auto;
    max-width: var(--layout-content);
  }
  .site-footer-wordmark {
    color: var(--color-pure-white);
    font: 400 32px / 0.9 var(--font-display);
    letter-spacing: 0.043em;
    text-decoration: none;
  }
  .site-footer-links {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(5, auto);
  }
  .site-footer-links a {
    color: var(--color-pure-white);
    font: var(--type-caption);
    letter-spacing: 0.133em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-footer-links button {
    background: transparent;
    border: 0;
    color: var(--color-pure-white);
    cursor: pointer;
    font: var(--type-caption);
    letter-spacing: 0.133em;
    padding: 0;
    text-align: left;
    text-transform: uppercase;
  }
  .site-footer-copyright {
    margin: 0;
    opacity: 0.78;
    text-align: right;
  }
  @media (max-width: 64rem) {
    .site-footer-content {
      grid-template-columns: 1fr;
    }
    .site-footer-links {
      gap: var(--space-sm) var(--space-lg);
      grid-template-columns: repeat(2, max-content);
      justify-self: center;
    }
    .site-footer-copyright {
      justify-self: center;
      text-align: center;
    }
  }
</style>
