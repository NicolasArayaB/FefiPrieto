---
import type { ActionLink } from "@app-types/content";

interface Props extends ActionLink {
  appearance?: "button" | "editorial";
  variant?: "primary" | "secondary";
  size?: "default" | "compact";
}

const {
  appearance = "button",
  href,
  label,
  variant = "secondary",
  size = "default",
} = Astro.props;
---

<a
  class:list={[
    "button-link",
    "type-button",
    `button-link-${appearance}`,
    `button-link-${variant}`,
    `button-link-${size}`,
  ]}
  href={href}
>
  <slot>{label}</slot>
</a>

<style>
  .button-link {
    align-items: center;
    border: 2px solid var(--color-burnt-orange);
    border-radius: var(--radius-control);
    display: inline-flex;
    gap: var(--space-xs);
    justify-content: center;
    min-height: var(--target-size);
    padding: var(--space-lg) var(--space-3xl);
    text-decoration: none;
    transition:
      background-color var(--motion-duration-fast) var(--motion-easing-standard),
      border-color var(--motion-duration-fast) var(--motion-easing-standard),
      color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .button-link-primary {
    background: var(--color-deep-indigo);
    border-color: var(--color-deep-indigo);
    color: var(--color-pure-white);
  }

  .button-link-primary:hover {
    background: var(--color-deep-indigo);
    border-color: var(--color-deep-indigo);
  }

  .button-link-secondary {
    background: transparent;
    color: var(--color-burnt-orange);
  }

  .button-link-secondary:hover {
    background: transparent;
    border-color: var(--color-burnt-orange);
  }

  .button-link-compact {
    min-height: calc(var(--target-size) - var(--space-2xs));
    padding: var(--space-md) var(--space-lg);
  }

  @media (max-width: 640px) {
    .button-link:not(.button-link-editorial) {
      width: 100%;
    }
  }
</style>
