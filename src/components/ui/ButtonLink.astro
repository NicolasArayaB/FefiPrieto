---
import type { ActionLink } from "@app-types/content";

interface Props extends ActionLink {
  variant?: "primary" | "secondary";
  size?: "default" | "compact";
}

const { href, label, variant = "secondary", size = "default" } = Astro.props;
---

<a
  class:list={[
    "button-link",
    "type-button",
    `button-link-${variant}`,
    `button-link-${size}`,
  ]}
  href={href}
>
  <slot>{label}</slot>
</a>

<style>
  .button-link {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-soft);
    display: inline-flex;
    gap: var(--space-2xs);
    justify-content: center;
    min-height: var(--target-size);
    padding: 0.9rem 1.25rem;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--easing-standard),
      background-color var(--duration-fast) var(--easing-standard),
      border-color var(--duration-fast) var(--easing-standard),
      color var(--duration-fast) var(--easing-standard),
      box-shadow var(--duration-fast) var(--easing-standard);
  }

  .button-link:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }

  .button-link-primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-surface-elevated);
  }

  .button-link-primary:hover {
    background: var(--color-brand-hover);
    border-color: var(--color-brand-hover);
  }

  .button-link-secondary {
    background: color-mix(
      in srgb,
      var(--color-surface-elevated) 64%,
      transparent
    );
    color: var(--color-text);
  }

  .button-link-secondary:hover {
    background: var(--color-surface-elevated);
    border-color: var(--color-border);
  }

  .button-link-compact {
    min-height: calc(var(--target-size) - 4px);
    padding: 0.75rem 1rem;
  }

  @media (max-width: 640px) {
    .button-link {
      width: 100%;
    }
  }
</style>
