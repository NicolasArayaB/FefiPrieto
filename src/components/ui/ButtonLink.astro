---
import type { ActionLink } from "@app-types/content";

interface Props extends ActionLink {
  appearance?: "button" | "editorial";
  variant?: "primary" | "secondary";
  size?: "default" | "compact";
}

const {
  appearance = "button",
  href,
  label,
  variant = "secondary",
  size = "default",
} = Astro.props;
---

<a
  class:list={[
    "button-link",
    "type-button",
    `button-link-${appearance}`,
    `button-link-${variant}`,
    `button-link-${size}`,
  ]}
  href={href}
>
  <slot>{label}</slot>
</a>

<style>
  .button-link {
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    display: inline-flex;
    gap: var(--space-xs);
    justify-content: center;
    min-height: var(--target-size);
    padding: var(--space-xs) var(--space-md);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--easing-standard),
      border-color var(--duration-fast) var(--easing-standard),
      color var(--duration-fast) var(--easing-standard);
  }

  .button-link-primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-surface);
  }

  .button-link-primary:hover {
    background: var(--color-brand-hover);
    border-color: var(--color-brand-hover);
  }

  .button-link-secondary {
    background: color-mix(in srgb, var(--color-surface) 64%, transparent);
    color: var(--color-text);
  }

  .button-link-secondary:hover {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .button-link-editorial {
    background: transparent;
    border: 0;
    border-block-end: 1px solid currentColor;
    border-radius: 0;
    justify-content: flex-start;
    padding: 0 0 var(--space-xs);
    width: fit-content;
  }

  .button-link-editorial.button-link-primary {
    color: var(--color-brand);
  }

  .button-link-editorial.button-link-secondary {
    color: var(--color-text);
  }

  .button-link-editorial:hover,
  .button-link-editorial.button-link-primary:hover,
  .button-link-editorial.button-link-secondary:hover {
    background: transparent;
  }

  .button-link-editorial.button-link-primary:hover {
    border-color: var(--color-brand-hover);
    color: var(--color-brand-hover);
  }

  .button-link-compact {
    min-height: calc(var(--target-size) - var(--space-2xs));
    padding: var(--space-2xs) var(--space-sm);
  }

  @media (max-width: 640px) {
    .button-link:not(.button-link-editorial) {
      width: 100%;
    }
  }
</style>
