---
interface Props {
  class?: string;
  size?: "content" | "reading" | "wide" | "full";
}

const { class: className, size = "content" } = Astro.props;
---

<div class:list={["container", `container-${size}`, className]}>
  <slot />
</div>

<style>
  .container {
    margin-inline: auto;
    max-width: calc(
      var(--width-content) + var(--space-page) + var(--space-page)
    );
    padding-inline: var(--space-page);
    width: 100%;
  }

  .container-reading {
    max-width: calc(
      var(--width-reading) + var(--space-page) + var(--space-page)
    );
  }

  .container-wide {
    max-width: calc(
      var(--width-editorial) + var(--space-page) + var(--space-page)
    );
  }

  .container-full {
    max-width: var(--width-full);
    padding-inline: 0;
  }
</style>
