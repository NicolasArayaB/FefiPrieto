---
interface Props {
  class?: string;
  size?: "default" | "narrow";
}

const { class: className, size = "default" } = Astro.props;
---

<div class:list={["container", `container-${size}`, className]}>
  <slot />
</div>

<style>
  .container {
    margin-inline: auto;
    max-width: var(--layout-max-width);
    padding-inline: var(--space-page);
    width: 100%;
  }

  .container-narrow {
    max-width: var(--layout-narrow-width);
  }
</style>
