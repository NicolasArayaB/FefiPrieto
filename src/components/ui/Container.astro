---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["container", className]}>
  <slot />
</div>

<style>
  .container {
    margin-inline: auto;
    max-width: var(--layout-max-width);
    padding-inline: var(--space-page);
    width: 100%;
  }
</style>
