---
import { siteMetadata } from "@constants/site";
import {
  individualInquiryEmail,
  individualInquiryHref,
  instagramUrl,
} from "@content/contact";
import PostHog from "@components/posthog.astro";
import AnalyticsConsent from "@components/ui/AnalyticsConsent.astro";
import SiteFooter from "@components/ui/SiteFooter.astro";
import bebasNeueFontUrl from "../assets/fonts/bebas-neue-latin-400.woff2?url";
import caveatFontUrl from "../assets/fonts/caveat-latin-400.woff2?url";
import interFontUrl from "../assets/fonts/inter-latin-400.woff2?url";
import socialShareImage from "../assets/images/fernanda-prieto-social-share.png";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const pageTitle =
  title === siteMetadata.title ? title : `${title} | ${siteMetadata.title}`;
const normalizedCanonicalPath =
  canonicalPath === "/"
    ? canonicalPath
    : `${canonicalPath.replace(/\/$/, "")}/`;
const canonicalUrl = new URL(
  normalizedCanonicalPath,
  siteMetadata.url,
).toString();
const socialImageUrl = new URL(
  socialShareImage.src,
  siteMetadata.url,
).toString();
const isHomePage = Astro.url.pathname === "/";
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  description: siteMetadata.description,
  email: individualInquiryEmail,
  image: socialImageUrl,
  jobTitle: "Psicóloga y asesora de imagen",
  knowsAbout: [
    "Psicología de la imagen",
    "Asesoría de imagen",
    "Identidad y presencia personal",
  ],
  name: "Fernanda Prieto",
  sameAs: [instagramUrl],
  url: siteMetadata.url,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="preload"
      href={bebasNeueFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={caveatFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="Fernanda Prieto, psicología e imagen"
    />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Fernanda Prieto, psicología e imagen"
    />
    <title>{pageTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personStructuredData)}
    />
    <PostHog />
  </head>
  <body class="site-shell">
    <header
      class="site-navigation"
      data-homepage={isHomePage ? "true" : "false"}
      data-site-navigation
    >
      <a class="site-wordmark" href="/" aria-label="Fernanda Prieto, inicio"
        >FERNANDA PRIETO</a
      >
      <nav aria-label="Navegación principal">
        <a href="#methodology">Método</a>
        <a href="#services">Servicios</a>
        <a href="#about">Sobre Fernanda</a>
      </nav>
      {
        isHomePage && (
          <details class="mobile-navigation">
            <summary class="type-caption">Menú</summary>
            <nav aria-label="Navegación móvil">
              <a href="#methodology">Método</a>
              <a href="#services">Servicios</a>
              <a href="#about">Sobre Fernanda</a>
            </nav>
          </details>
        )
      }
      <a
        class="navigation-cta"
        href={individualInquiryHref("Consulta individual")}
        data-analytics-inquiry
        data-analytics-placement="navigation">Conversemos</a
      >
    </header>
    <slot />
    <SiteFooter />
    <AnalyticsConsent />
    <script>
      import { initStickyNavigation } from "@animations/navigation";

      initStickyNavigation();
    </script>
  </body>
</html>

<style>
  .site-navigation {
    align-items: center;
    background: var(--color-cream-paper);
    display: flex;
    gap: var(--space-xl);
    justify-content: space-between;
    left: 0;
    padding: var(--space-md) var(--space-page);
    position: absolute;
    right: 0;
    top: 0;
    z-index: 10;
    transition:
      background-color var(--motion-duration-standard)
        var(--motion-easing-standard),
      box-shadow var(--motion-duration-standard) var(--motion-easing-standard),
      padding var(--motion-duration-standard) var(--motion-easing-standard);
  }
  .site-wordmark {
    color: var(--color-deep-indigo);
    font: 400 32px / 0.9 var(--font-display);
    letter-spacing: 0.043em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-2xl);
  }
  nav a {
    color: var(--color-deep-indigo);
    font: var(--type-caption);
    letter-spacing: 0.133em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .navigation-cta {
    background: var(--color-deep-indigo);
    border-radius: var(--radius-control);
    color: var(--color-pure-white);
    font: var(--type-button);
    letter-spacing: 0.1em;
    padding: var(--space-md) var(--space-xl);
    text-decoration: none;
    text-transform: uppercase;
  }
  .mobile-navigation {
    display: none;
  }
  .site-navigation[data-homepage="false"] > nav {
    display: none;
  }
  .site-navigation.is-scrolled {
    background: var(--color-deep-indigo);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-xl);
    left: 50%;
    padding: var(--space-sm) var(--space-xl);
    position: fixed;
    right: auto;
    top: var(--space-md);
    transform: translateX(-50%);
    width: max-content;
  }
  .site-navigation.is-scrolled .site-wordmark,
  .site-navigation.is-scrolled .navigation-cta,
  .site-navigation.is-scrolled .mobile-navigation {
    display: none;
  }
  .site-navigation.is-scrolled nav {
    display: flex;
    gap: var(--space-xl);
  }
  .site-navigation.is-scrolled nav a {
    color: var(--color-pure-white);
    white-space: nowrap;
  }
  .site-navigation[data-homepage="false"].is-scrolled {
    background: transparent;
    box-shadow: none;
    padding: 0;
  }
  .site-navigation[data-homepage="false"].is-scrolled nav {
    display: none;
  }
  .site-navigation[data-homepage="false"].is-scrolled .navigation-cta {
    display: block;
  }
  @media (max-width: 48rem) {
    .site-navigation {
      padding-block: var(--space-sm);
    }
    nav {
      display: none;
    }
    .mobile-navigation {
      display: block;
      position: relative;
    }
    .mobile-navigation summary {
      align-items: center;
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      color: var(--color-deep-indigo);
      cursor: pointer;
      display: flex;
      height: var(--target-size);
      justify-content: center;
      list-style: none;
      width: var(--target-size);
    }
    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation[open] summary {
      background: var(--color-deep-indigo);
      color: var(--color-pure-white);
    }
    .mobile-navigation nav {
      background: var(--color-cream-paper);
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      display: grid;
      gap: var(--space-md);
      min-width: 11rem;
      padding: var(--space-lg);
      position: absolute;
      left: 0;
      top: calc(100% + var(--space-xs));
      z-index: 1;
    }
    .mobile-navigation nav a {
      min-height: var(--target-size);
      padding-block: var(--space-md);
    }
    .navigation-cta {
      padding: var(--space-sm) var(--space-md);
    }
    .site-navigation.is-scrolled {
      max-width: calc(100% - var(--space-page) - var(--space-page));
      padding-inline: var(--space-lg);
    }
    .site-navigation.is-scrolled nav {
      gap: var(--space-md);
    }
  }
  @media (max-width: 389px) {
    .site-navigation[data-homepage="true"] .navigation-cta {
      display: none;
    }
  }
</style>
