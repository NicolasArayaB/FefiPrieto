---
import { siteMetadata } from "@constants/site";
import { individualInquiryHref } from "@content/contact";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const pageTitle =
  title === siteMetadata.title ? title : `${title} | ${siteMetadata.title}`;
const canonicalUrl = new URL(canonicalPath, siteMetadata.url).toString();
const isHomePage = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@400;500&family=Inter:wght@400;500&family=Jost:wght@400;500&family=Oswald:wght@400&display=swap"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body class="site-shell">
    <header
      class="site-navigation"
      data-homepage={isHomePage ? "true" : "false"}
      data-site-navigation
    >
      <a class="site-wordmark" href="/" aria-label="Fernanda Prieto, inicio"
        >FERNANDA PRIETO</a
      >
      <nav aria-label="Navegación principal">
        <a href="#methodology">Método</a>
        <a href="#services">Servicios</a>
        <a href="#about">Sobre Fernanda</a>
      </nav>
      {
        isHomePage && (
          <details class="mobile-navigation">
            <summary class="type-caption">Menú</summary>
            <nav aria-label="Navegación móvil">
              <a href="#methodology">Método</a>
              <a href="#services">Servicios</a>
              <a href="#about">Sobre Fernanda</a>
            </nav>
          </details>
        )
      }
      <a
        class="navigation-cta"
        href={individualInquiryHref("Consulta individual")}>Conversemos</a
      >
    </header>
    <slot />
    <script>
      import { initStickyNavigation } from "@animations/navigation";

      initStickyNavigation();
    </script>
  </body>
</html>

<style>
  .site-navigation {
    align-items: center;
    background: var(--color-cream-paper);
    display: flex;
    gap: var(--space-xl);
    justify-content: space-between;
    left: 0;
    padding: var(--space-md) var(--space-page);
    position: absolute;
    right: 0;
    top: 0;
    z-index: 10;
    transition:
      background-color var(--motion-duration-standard)
        var(--motion-easing-standard),
      box-shadow var(--motion-duration-standard) var(--motion-easing-standard),
      padding var(--motion-duration-standard) var(--motion-easing-standard);
  }
  .site-wordmark {
    color: var(--color-deep-indigo);
    font: 400 32px / 0.9 var(--font-display);
    letter-spacing: 0.043em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-2xl);
  }
  nav a {
    color: var(--color-deep-indigo);
    font: var(--type-caption);
    letter-spacing: 0.133em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .navigation-cta {
    background: var(--color-deep-indigo);
    border-radius: var(--radius-control);
    color: var(--color-pure-white);
    font: var(--type-button);
    letter-spacing: 0.1em;
    padding: var(--space-md) var(--space-xl);
    text-decoration: none;
    text-transform: uppercase;
  }
  .mobile-navigation {
    display: none;
  }
  .site-navigation[data-homepage="false"] > nav {
    display: none;
  }
  .site-navigation.is-scrolled {
    background: var(--color-deep-indigo);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-xl);
    left: 50%;
    padding: var(--space-sm) var(--space-xl);
    position: fixed;
    right: auto;
    top: var(--space-md);
    transform: translateX(-50%);
    width: max-content;
  }
  .site-navigation.is-scrolled .site-wordmark,
  .site-navigation.is-scrolled .navigation-cta,
  .site-navigation.is-scrolled .mobile-navigation {
    display: none;
  }
  .site-navigation.is-scrolled nav {
    display: flex;
    gap: var(--space-xl);
  }
  .site-navigation.is-scrolled nav a {
    color: var(--color-pure-white);
    white-space: nowrap;
  }
  .site-navigation[data-homepage="false"].is-scrolled {
    background: transparent;
    box-shadow: none;
    padding: 0;
  }
  .site-navigation[data-homepage="false"].is-scrolled nav {
    display: none;
  }
  .site-navigation[data-homepage="false"].is-scrolled .navigation-cta {
    display: block;
  }
  @media (max-width: 48rem) {
    .site-navigation {
      padding-block: var(--space-sm);
    }
    nav {
      display: none;
    }
    .mobile-navigation {
      display: block;
      position: relative;
    }
    .mobile-navigation summary {
      align-items: center;
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      color: var(--color-deep-indigo);
      cursor: pointer;
      display: flex;
      height: var(--target-size);
      justify-content: center;
      list-style: none;
      width: var(--target-size);
    }
    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation[open] summary {
      background: var(--color-deep-indigo);
      color: var(--color-pure-white);
    }
    .mobile-navigation nav {
      background: var(--color-cream-paper);
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      display: grid;
      gap: var(--space-md);
      min-width: 11rem;
      padding: var(--space-lg);
      position: absolute;
      left: 0;
      top: calc(100% + var(--space-xs));
      z-index: 1;
    }
    .mobile-navigation nav a {
      min-height: var(--target-size);
      padding-block: var(--space-md);
    }
    .navigation-cta {
      padding: var(--space-sm) var(--space-md);
    }
    .site-navigation.is-scrolled {
      max-width: calc(100% - var(--space-page) - var(--space-page));
      padding-inline: var(--space-lg);
    }
    .site-navigation.is-scrolled nav {
      gap: var(--space-md);
    }
  }
</style>
