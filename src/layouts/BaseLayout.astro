---
import LanguageSwitcher from "@components/ui/LanguageSwitcher.astro";
import { contentFor } from "@content/localized";
import { ui } from "@content/ui";
import { getLocale, pagePath, locales, type PageId } from "@lib/i18n";
import { siteMetadata } from "@constants/site";
import {
  individualInquiryEmail,
  individualInquiryHref,
  instagramUrl,
} from "@content/contact";
import PostHog from "@components/posthog.astro";
import AnalyticsConsent from "@components/ui/AnalyticsConsent.astro";
import SiteFooter from "@components/ui/SiteFooter.astro";
import bebasNeueFontUrl from "../assets/fonts/bebas-neue-latin-400.woff2?url";
import caveatFontUrl from "../assets/fonts/caveat-latin-400.woff2?url";
import interFontUrl from "../assets/fonts/inter-latin-400.woff2?url";
import socialShareImage from "../assets/images/fernanda-prieto-social-share.webp";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageId: PageId;
}

const locale = getLocale(Astro.currentLocale);
const text = ui[locale];
const { metadata } = contentFor(locale);
const {
  title = metadata.title,
  description = metadata.description,
  pageId,
} = Astro.props;
const canonicalPath = pagePath(pageId, locale);
const pageTitle =
  title === siteMetadata.title ? title : `${title} | ${siteMetadata.title}`;
const normalizedCanonicalPath =
  canonicalPath === "/"
    ? canonicalPath
    : `${canonicalPath.replace(/\/$/, "")}/`;
const canonicalUrl = new URL(
  normalizedCanonicalPath,
  siteMetadata.url,
).toString();
const socialImageUrl = new URL(
  socialShareImage.src,
  siteMetadata.url,
).toString();
const isHomePage = pageId === "home";
const homePath = pagePath("home", locale);
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  description: metadata.description,
  email: individualInquiryEmail,
  image: socialImageUrl,
  jobTitle: text.jobTitle,
  knowsAbout: text.knowsAbout,
  name: "Fernanda Prieto",
  sameAs: [instagramUrl],
  url: siteMetadata.url,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="preload"
      href={bebasNeueFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={caveatFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonicalUrl} />
    {
      locales.map((language) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(
            pagePath(pageId, language),
            siteMetadata.url,
          ).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pagePath(pageId, "es"), siteMetadata.url).toString()}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={text.socialImage} />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:locale" content={locale === "es" ? "es_CL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={text.socialImage} />
    <title>{pageTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personStructuredData)}
    />
    <PostHog />
  </head>
  <body class="site-shell">
    <header
      class="site-navigation"
      data-homepage={isHomePage ? "true" : "false"}
      data-site-navigation
    >
      <a class="site-wordmark" href={homePath} aria-label={text.home}
        >FERNANDA PRIETO</a
      >
      <nav aria-label={text.mainNav}>
        <a href={isHomePage ? "#methodology" : `${homePath}#methodology`}
          >{text.method}</a
        >
        <a href={isHomePage ? "#services" : `${homePath}#services`}
          >{text.services}</a
        >
        <a href={isHomePage ? "#about" : `${homePath}#about`}>{text.about}</a>
      </nav>
      {
        isHomePage && (
          <details class="mobile-navigation">
            <summary class="type-caption">{text.menu}</summary>
            <nav aria-label={text.mobileNav}>
              <a href={isHomePage ? "#methodology" : `${homePath}#methodology`}>
                {text.method}
              </a>
              <a href={isHomePage ? "#services" : `${homePath}#services`}>
                {text.services}
              </a>
              <a href={isHomePage ? "#about" : `${homePath}#about`}>
                {text.about}
              </a>
            </nav>
          </details>
        )
      }
      <LanguageSwitcher locale={locale} pageId={pageId} />
      <a
        class="navigation-cta"
        href={individualInquiryHref(text.inquiry)}
        data-analytics-inquiry
        data-analytics-placement="navigation">{text.talk}</a
      >
    </header>
    <slot />
    <SiteFooter />
    <AnalyticsConsent />
    <script>
      import { initStickyNavigation } from "@animations/navigation";

      initStickyNavigation();
    </script>
  </body>
</html>

<style>
  .site-navigation {
    align-items: center;
    background: var(--color-cream-paper);
    display: flex;
    gap: var(--space-md);
    color: var(--color-deep-indigo);
    justify-content: space-between;
    left: 0;
    padding: var(--space-md) var(--space-page);
    position: absolute;
    right: 0;
    top: 0;
    z-index: 10;
    transition:
      background-color var(--motion-duration-standard)
        var(--motion-easing-standard),
      box-shadow var(--motion-duration-standard) var(--motion-easing-standard),
      padding var(--motion-duration-standard) var(--motion-easing-standard);
  }
  .site-wordmark {
    color: var(--color-deep-indigo);
    font: 400 32px / 0.9 var(--font-display);
    letter-spacing: 0.043em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-xl);
  }
  nav a {
    color: var(--color-deep-indigo);
    font: var(--type-caption);
    letter-spacing: 0.133em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .navigation-cta {
    background: var(--color-deep-indigo);
    border-radius: var(--radius-control);
    color: var(--color-pure-white);
    font: var(--type-button);
    letter-spacing: 0.1em;
    padding: var(--space-md) var(--space-xl);
    text-decoration: none;
    text-transform: uppercase;
  }
  .mobile-navigation {
    display: none;
  }
  .site-navigation[data-homepage="true"]:not(.is-scrolled) .navigation-cta {
    display: none;
  }
  .site-navigation.is-scrolled :global(.language-switcher) {
    display: none;
  }
  .site-navigation[data-homepage="false"] > nav {
    display: none;
  }
  .site-navigation.is-scrolled {
    background: var(--color-deep-indigo);
    color: var(--color-pure-white);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-xl);
    left: 50%;
    padding: var(--space-sm) var(--space-xl);
    position: fixed;
    right: auto;
    top: var(--space-md);
    transform: translateX(-50%);
    width: max-content;
  }
  .site-navigation.is-scrolled .site-wordmark,
  .site-navigation.is-scrolled .navigation-cta,
  .site-navigation.is-scrolled .mobile-navigation {
    display: none;
  }
  .site-navigation.is-scrolled nav {
    display: flex;
    gap: var(--space-xl);
  }
  .site-navigation.is-scrolled nav a {
    color: var(--color-pure-white);
    white-space: nowrap;
  }
  .site-navigation[data-homepage="false"].is-scrolled {
    background: var(--color-deep-indigo);
    box-shadow: none;
  }
  .site-navigation[data-homepage="false"].is-scrolled nav {
    display: none;
  }
  .site-navigation[data-homepage="false"].is-scrolled .navigation-cta {
    display: block;
    padding: 0;
  }
  @media (max-width: 48rem) {
    .site-navigation {
      flex-wrap: wrap;
      column-gap: var(--space-sm);
      row-gap: 0;
      padding-block: var(--space-sm);
    }
    .site-wordmark {
      flex-basis: 100%;
      font-size: 28px;
    }
    nav {
      display: none;
    }
    .mobile-navigation {
      display: block;
      position: relative;
    }
    .mobile-navigation summary {
      align-items: center;
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      color: var(--color-deep-indigo);
      cursor: pointer;
      display: flex;
      height: var(--target-size);
      justify-content: center;
      list-style: disclosure-closed;
      min-width: var(--target-size);
      padding-inline: var(--space-sm);
    }
    .mobile-navigation summary::after {
      content: " ▾";
    }
    .mobile-navigation[open] summary {
      background: var(--color-deep-indigo);
      color: var(--color-pure-white);
    }
    .mobile-navigation nav {
      background: var(--color-cream-paper);
      border: 1px solid var(--color-deep-indigo);
      border-radius: var(--radius-card);
      display: grid;
      gap: var(--space-md);
      min-width: 11rem;
      padding: var(--space-lg);
      position: absolute;
      right: 0;
      top: calc(100% + var(--space-xs));
      z-index: 1;
    }
    .mobile-navigation nav a {
      min-height: var(--target-size);
      padding-block: var(--space-md);
    }
    .navigation-cta {
      padding: var(--space-sm) var(--space-md);
    }
    .site-navigation.is-scrolled {
      max-width: calc(100% - var(--space-page) - var(--space-page));
      padding-inline: var(--space-lg);
    }
    .site-navigation.is-scrolled {
      justify-content: center;
      width: max-content;
    }
    .site-navigation.is-scrolled nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-md);
    }
  }
  @media (min-width: 390px) and (max-width: 48rem) {
    .mobile-navigation nav {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }
  }
  @media (max-width: 389px) {
    .site-navigation[data-homepage="true"] .navigation-cta {
      display: none;
    }
  }
</style>
